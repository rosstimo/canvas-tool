#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v uv >/dev/null 2>&1; then
    echo 'Error: uv is required when running canvas-tool from a source checkout.' >&2
    echo 'Install uv, or use a packaged canvas-tool release when available.' >&2
    exit 127
fi

export CANVAS_TOOL_ROOT="$ROOT"
exec uv run --project "$ROOT" -- python -m canvas_tool "$@"
